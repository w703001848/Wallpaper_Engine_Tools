{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "outDir": "dist-electron",
    "rootDir": ".",
    "types": ["node", "vitest/globals"]
  },
  "include": ["electron/**/*.ts", "electron/**/*.cts", "src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "vite.config.ts", "vitest.config.ts"]
}
